      "initials": "TW",
      "department": "support",
      "maxInstances": 2,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "bizdev",
        "business_analyst",
        "project_manager",
        "uiux",
        "architect",
        "finance_legal",
        "qa",
        "security",
        "devops",
        "support"
