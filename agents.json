// Virtual Company registry.
// Add a position = add an entry to "agents" and put its id in a "pipeline" stage.
// Model resolution (first match wins):
//   project override [agent] > project override ["*"] > global override [agent] > global override ["*"]
//   > agent.model > department.model > defaults.model
{
  "company": "Nusantara Digital Works",
  "defaults": {
    "model": "claude-sonnet-5-5",
    "effort": "medium",
    "maxTokens": 16000,
    "maxOutputTokens": 8000
  },
  "models": [
    {
      "id": "claude-fable-5-2",
      "label": "Fable 5.2",
      "tier": "fable",
      "inputPrice": 8,
      "outputPrice": 40
    },
    {
      "id": "claude-fable-5-1",
      "label": "Fable 5.1",
      "tier": "fable",
      "inputPrice": 10,
      "outputPrice": 50
    },
    {
      "id": "claude-opus-5-5",
      "label": "Opus 5.5",
      "tier": "opus",
      "inputPrice": 4,
      "outputPrice": 20
    },
    {
      "id": "claude-sonnet-5-5",
      "label": "Sonnet 5.5",
      "tier": "sonnet",
      "inputPrice": 2,
      "outputPrice": 10
    },
    {
      "id": "claude-haiku-5-5",
      "label": "Haiku 5.5",
      "tier": "haiku",
      "inputPrice": 0.1,
      "outputPrice": 0.5
    }
  ],
  "budget": {
    "maxTokensPerProject": 600000
  },
  "departments": {
    "support": {
      "name": "Operations & Support",
      "model": "claude-haiku-5-5"
    },
    "business": {
      "name": "Business & Strategy"
    },
    "finance": {
      "name": "Finance & Administration"
    },
    "product": {
      "name": "Product & Analysis",
      "model": "claude-opus-5-5"
    },
    "design": {
      "name": "Design"
    },
    "engineering": {
      "name": "Engineering"
    },
    "infra": {
      "name": "Infrastructure & Security"
    },
    "marketing": {
      "name": "Marketing & Growth"
    },
    "data": {
      "name": "Data & Analytics"
    }
  },
  "overrides": {},
  "agents": [
    {
      "id": "intake",
      "role": "Customer Intake",
      "initials": "CI",
      "department": "support",
      "effort": "low",
      "maxInstances": 20,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [],
      "maxOutputTokens": 1500,
      "greeting": "Hi, I'm the intake assistant at Nusantara Digital Works. Tell me about the problem you want solved, and I'll make sure the right team picks it up.",
      "persona": "You run the first conversation with a new customer. Find out, one question at a time: the business problem, who the users are and how many, the 3-5 core features, systems it must integrate with, and constraints (deadline, budget). Be warm and brief. Reply in the language the customer writes in.",
      "outputs": []
    },
    {
      "id": "bizdev",
      "role": "Business Development",
      "initials": "BD",
      "department": "business",
      "maxInstances": 2,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [],
      "maxOutputTokens": 5000,
      "persona": "You qualify the opportunity and write a proposal: problem summary, proposed solution, scope in/out, phased timeline in weeks, team composition, and a quotation in IDR with a line per phase. State assumptions explicitly.",
      "outputs": [
        "proposal"
      ]
    },
    {
      "id": "business_analyst",
      "role": "Business Analyst",
      "initials": "BA",
      "department": "product",
      "maxInstances": 3,
      "spawnable": false,
      "canAskCustomer": true,
      "reads": [
        "bizdev"
      ],
      "maxOutputTokens": 9000,
      "persona": "You write the Business Requirements Document: stakeholders, as-is and to-be process (numbered steps), business rules (BR-01...), functional requirements as user stories with acceptance criteria (Given/When/Then), non-functional requirements, and a requirement traceability table. If a requirement that changes the design is unknown, return status need_info with at most 3 precise questions.",
      "outputs": [
        "brd"
      ]
    },
    {
      "id": "project_manager",
      "role": "Project Manager",
      "initials": "PM",
      "department": "product",
      "maxInstances": 1,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "bizdev"
      ],
      "maxOutputTokens": 5000,
      "persona": "You are the orchestrator. Break the approved requirements into modules, write a work breakdown with owners and week numbers, list risks, and decide how many developer instances to staff. Put the decision in the handoff data as {\"modules\": [..], \"instances\": {\"frontend_dev\": n, \"backend_dev\": n, \"qa\": 1}}.",
      "outputs": [
        "plan"
      ]
    },
    {
      "id": "uiux",
      "role": "UI/UX Designer",
      "initials": "UX",
      "department": "design",
      "maxInstances": 2,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "project_manager"
      ],
      "maxOutputTokens": 7000,
      "persona": "You design the user experience: user journeys per role, screen inventory, a text wireframe for each key screen (layout regions and components), navigation map, and design tokens (colors, type scale, spacing).",
      "outputs": [
        "ux-spec"
      ]
    },
    {
      "id": "architect",
      "role": "Solution Architect",
      "initials": "SA",
      "department": "engineering",
      "model": "claude-opus-5-5",
      "maxInstances": 2,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "project_manager"
      ],
      "maxOutputTokens": 8000,
      "persona": "You define the architecture: component diagram (as a text list of components and their connections), technology choices with one-line reasons, the database schema (tables, key columns, relations), REST API endpoints (method, path, purpose), authentication, and deployment topology.",
      "outputs": [
        "architecture"
      ]
    },
    {
      "id": "finance_legal",
      "role": "Finance & Legal",
      "initials": "FL",
      "department": "finance",
      "model": "claude-haiku-5-5",
      "maxInstances": 1,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "bizdev",
        "project_manager"
      ],
      "maxOutputTokens": 3000,
      "disabled": true,
      "persona": "You prepare the commercial side: statement of work summary, payment milestones tied to deliverables, invoice schedule, acceptance criteria for sign-off, warranty and support terms, and key contract clauses (IP, confidentiality, change requests).",
      "outputs": [
        "contract"
      ]
    },
    {
      "id": "frontend_dev",
      "role": "Frontend Developer",
      "initials": "FE",
      "department": "engineering",
      "maxInstances": 4,
      "spawnable": true,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "project_manager",
        "uiux",
        "architect"
      ],
      "maxOutputTokens": 10000,
      "persona": "You build the frontend for the module you are assigned: list the pages and components, then write the key component code. Follow the UX spec and the API contract exactly.",
      "outputs": [
        "frontend"
      ]
    },
    {
      "id": "backend_dev",
      "role": "Backend Developer",
      "initials": "BE",
      "department": "engineering",
      "maxInstances": 5,
      "spawnable": true,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "project_manager",
        "architect"
      ],
      "maxOutputTokens": 10000,
      "persona": "You build the backend for the module you are assigned: endpoints, validation, business rules enforcement, and the key service code. Reference business rule ids (BR-xx) in comments where they are enforced.",
      "outputs": [
        "backend"
      ]
    },
    {
      "id": "db_dev",
      "role": "Database Developer",
      "initials": "DB",
      "department": "engineering",
      "maxInstances": 2,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "architect"
      ],
      "maxOutputTokens": 7000,
      "persona": "You write the database migration scripts (CREATE TABLE with keys, indexes and constraints), seed data, and the reporting views that the KPIs will need.",
      "outputs": [
        "database"
      ]
    },
    {
      "id": "qa",
      "role": "QA Engineer",
      "initials": "QA",
      "department": "engineering",
      "maxInstances": 3,
      "spawnable": true,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "architect",
        "frontend_dev",
        "backend_dev",
        "db_dev"
      ],
      "maxOutputTokens": 6000,
      "persona": "You test the build against the acceptance criteria: write test cases (id, steps, expected), the UAT scenario for every role, run them against the code you were given, and report defects with severity. Put {\"bugs\": n, \"defects\": [\"...\"]} in the handoff data; n = 0 means ready to release.",
      "outputs": [
        "test-report"
      ]
    },
    {
      "id": "security",
      "role": "Security Engineer",
      "initials": "SE",
      "department": "infra",
      "model": "claude-opus-5-5",
      "maxInstances": 2,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "architect",
        "backend_dev",
        "db_dev",
        "qa"
      ],
      "maxOutputTokens": 4000,
      "persona": "You review the architecture and code for security: authentication and authorization gaps, injection, secrets handling, data exposure, logging, and OWASP Top 10 items. Give each finding a severity and a fix. Block the release (status blocked) only for critical findings.",
      "outputs": [
        "security-review"
      ]
    },
    {
      "id": "devops",
      "role": "DevOps Engineer",
      "initials": "DO",
      "department": "infra",
      "maxInstances": 1,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "architect",
        "db_dev",
        "qa",
        "security"
      ],
      "maxOutputTokens": 4000,
      "persona": "You prepare the release: CI/CD pipeline stages, environment configuration (staging, production), container/hosting setup, domain and SSL, database migration order, backup and rollback plan, and monitoring alerts.",
      "outputs": [
        "release-plan"
      ]
    },
    {
      "id": "marketing",
      "role": "Marketing Lead",
      "initials": "MK",
      "department": "marketing",
      "maxInstances": 1,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "bizdev",
        "business_analyst",
        "project_manager"
      ],
      "maxOutputTokens": 3000,
      "disabled": true,
      "persona": "You plan the launch and adoption: audience segments, key messages, internal launch announcement text, onboarding/training plan, and adoption KPIs with targets.",
      "outputs": [
        "launch-plan"
      ]
    },
    {
      "id": "support",
      "role": "Customer Support",
      "initials": "CS",
      "department": "support",
      "maxInstances": 1,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "qa"
      ],
      "maxOutputTokens": 3000,
      "persona": "You set up operations after go-live: SLA tiers and response times, ticket categories, escalation path to engineering, a FAQ for end users, and the incident handling procedure.",
      "outputs": [
        "support-runbook"
      ]
    },
    {
      "id": "data_analyst",
      "role": "Data Analyst",
      "initials": "DA",
      "department": "data",
      "maxInstances": 2,
      "spawnable": false,
      "canAskCustomer": false,
      "reads": [
        "business_analyst",
        "architect",
        "db_dev"
      ],
      "maxOutputTokens": 4000,
      "persona": "You define how success is measured: KPI list with formulas and the source tables, dashboard layout, the SQL for the top KPIs, and the first improvement hypotheses to feed back to the Project Manager.",
      "outputs": [
        "kpi-dashboard"
      ]
    }
  ],
  "pipeline": [
    {
      "id": "discovery",
      "title": "Discovery chat",
      "kind": "chat",
      "agents": [
        "intake"
      ]
    },
    {
      "id": "proposal",
      "title": "Proposal",
      "kind": "agents",
      "agents": [
        "bizdev"
      ],
      "gate": {
        "id": "proposal",
        "label": "Approve proposal & quotation"
      }
    },
    {
      "id": "requirements",
      "title": "Requirements",
      "kind": "agents",
      "agents": [
        "business_analyst"
      ],
      "gate": {
        "id": "requirements",
        "label": "Approve requirements (BRD)"
      }
    },
    {
      "id": "planning",
      "title": "Planning",
      "kind": "agents",
      "agents": [
        "project_manager"
      ]
    },
    {
      "id": "design",
      "title": "Design & contract",
      "kind": "agents",
      "agents": [
        "uiux",
        "architect",
        "finance_legal"
      ]
    },
    {
      "id": "build",
      "title": "Build",
      "kind": "agents",
      "agents": [
        "frontend_dev",
        "backend_dev",
        "db_dev"
      ]
    },
    {
      "id": "qa",
      "title": "Quality assurance",
      "kind": "agents",
      "agents": [
        "qa"
      ],
      "loop": {
        "backTo": "build",
        "maxRounds": 3
      }
    },
    {
      "id": "security",
      "title": "Security review",
      "kind": "agents",
      "agents": [
        "security"
      ]
    },
    {
      "id": "release",
      "title": "Release",
      "kind": "agents",
      "agents": [
        "devops"
      ],
      "gate": {
        "id": "production",
        "label": "Approve production deploy"
      }
    },
    {
      "id": "growth",
      "title": "Launch & operate",
      "kind": "agents",
      "agents": [
        "marketing",
        "support",
        "data_analyst"
      ]
    }
  ]
}
